# Copia este archivo a .env y ajusta lo que necesites.
# .env esta en .gitignore: nunca subas secretos al repositorio.

PORT=4000

# Origen del cliente en desarrollo (Vite). Separa varios con comas.
CLIENT_ORIGIN=http://localhost:5173

# Ruta del archivo SQLite. Relativa a packages/server.
DATABASE_PATH=data/minibarbara.sqlite

# Secreto para firmar los tokens de sesion. Se usara en el paso de auth.
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-en-local-por-un-valor-aleatorio-largo
